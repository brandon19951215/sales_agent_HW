# Copy to .env locally and enter your own API key there.
# Never commit .env or copy credentials from the original notebook.
OPENAI_API_KEY=

# Set a model available to your OpenAI account before running the agent.
OPENAI_MODEL=

# Planned Docker Compose service address. For local Python execution,
# override with http://127.0.0.1:8001/mcp.
MCP_SERVER_URL=http://mcp:8001/mcp
